# German UI catalog for the Thesis Text Analyzer (#28, ADR-0020).
#
# German is the DEFAULT locale (SDD Sec. 9.6), so this file is what a
# professor actually reads. Rules, both enforced by
# tests/core/test_i18n_catalogs.py:
#
#   * every msgid needs a non-empty msgstr - a partial catalog is a UI
#     that mixes languages sentence by sentence;
#   * the {placeholders} of a msgstr must match its msgid's, or the
#     render raises KeyError in the locale nobody reads first.
#
# After editing: python packaging/compile_catalogs.py
# (tta.mo is committed too - a missing .mo falls back to English
# silently, and there is no build step to generate one.)
msgid ""
msgstr ""
"Project-Id-Version: tta\n"
"Report-Msgid-Bugs-To: https://github.com/olistroemer/Thesis_Text_Analyzer/issues\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

